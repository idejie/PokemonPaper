{
  "name": "pokemonpaper",
  "private": true,
  "version": "0.16.1",
  "type": "module",
  "description": "PokemonPaper — 论文图鉴：多用户、每篇论文一只精灵，读完点亮。arXiv 导入、PDF 本地化、AI 速读卡。",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
